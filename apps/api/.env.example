PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Cocok dengan docker-compose.yml di root repo (Postgres di port 5433)
DATABASE_URL="postgresql://postgres:devpass@localhost:5433/veteran_achieve"

# Isi dengan string acak panjang, jangan dipakai bersama di luar laptop dev
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (buat OAuth Client di Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
ALLOWED_EMAIL_DOMAIN=mahasiswa.upnvj.ac.id
# Email Google admin untuk seed, pisahkan dengan koma
ADMIN_EMAILS=

# Payment gateway sandbox
MIDTRANS_SERVER_KEY=
